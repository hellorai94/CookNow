        <script><![CDATA[var TrainingScheduler = Class.create();
TrainingScheduler.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

   checkTrainingExists: function() {
      var course = this.getParameter('training');
      var trainingDate = this.getParameter('date');

      var day = trainingDate.split('/')[0];
      var month = trainingDate.split('/')[1];
      var year = '20' + trainingDate.split('/')[2];
      var formattedDate = day + '/' + month + '/' + year;
      var inputDate = new GlideDateTime(formattedDate + ' 00:00:00');

      var gr = new GlideRecord('x_1593191_cooknow_training_schedule');
      gr.addQuery('training', course);
      gr.query();

      while (gr.next()) {
         var scheduledDate = gr.getValue('date');
         var scheduledDay = scheduledDate.split('/')[0];
         var scheduledMonth = scheduledDate.split('/')[1];
         var scheduledYear = '20' + scheduledDate.split('/')[2];
         var formattedScheduledDate = scheduledDay + '/' + scheduledMonth + '/' + scheduledYear;
         var scheduledGlideDate = new GlideDateTime(formattedScheduledDate + ' 00:00:00');

         if (inputDate.getDate() == scheduledGlideDate.getDate()) {
            return 'true';
         }
      }
      return 'false';
   }
});]]></script>
