        <field>date</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>Validate Date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === oldValue) {
        return;
    }
    var trainingId = g_form.getValue('training');
    var dateId = g_form.getValue('date');

    var glideAjax = new GlideAjax('x_1593191_cooknow.DateUtils');

    glideAjax.addParam('sysparm_name', 'checkDuplicates');
    glideAjax.addParam('sysparm_trainingId', trainingId);
    glideAjax.addParam('sysparm_dateId', dateId);
    
    glideAjax.getXMLAnswer(function(response) {
        if (response == 'true') {
            g_form.addErrorMessage("There is already a training scheduled for this course on the same date.");
            g_form.setValue('date', "");
        } else {
            g_form.clearMessages();
        }
    });
}]]></script>
