        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingScheduler = Class.create();
TrainingScheduler.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    
    checkTrainingExists: function() {
        var course = this.getParameter('training'); // Obtém o curso
        var trainingDate = this.getParameter('date'); // Obtém a data no formato yyyy-mm-dd
        
        // Verificar se já existe um registro para o curso e data no banco
        var gr = new GlideRecord('x_1593191_cooknow_training'); // Substitua pela sua tabela
        gr.addQuery('training', course);
        gr.addQuery('date', trainingDate);
        gr.query();
        
        if (gr.next()) {
            // Retorna 'true' se já existe um treinamento agendado
            return 'true';
        }
        
        // Retorna 'false' se não houver um treinamento agendado para essa data
        return 'false';
    }
});]]></script>
