        <name>TrainingValidation</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingValidation = Class.create();
TrainingValidation.prototype = {
    initialize: function() {},

    validateSchedule: function(training, date) {
        if (!training || !date) {
            return { valid: false, message: "Treinamento ou data não fornecidos." };
        }

        var schedule = new GlideRecord('x_1593191_cooknow_training_schedule');
        schedule.addQuery('training', training);
        schedule.addQuery('date', date);
        schedule.query();

        if (schedule.next()) {
            return {
                valid: false,
                message: "Já existe um curso agendado para esta data!"
            };
        }

        return { valid: true };
    },

    type: 'TrainingValidation'
};]]></script>
