    checkDuplicates: function() {
        var date = this.getParameter("sysparm_trainingId");
        var course = this.getParameter("sysparm_dateId");
 
        var grTraining = new GlideRecord("x_1593191_cooknow_training_schedule");
        grTraining.addQuery("training", course);
        grTraining.addQuery("date", date);
        grTraining.query();
 
        if (grTraining.next()) {
            return true;
        } else {
            return false;
        }
    },
    type: 'DateUtils'
});]]></script>
