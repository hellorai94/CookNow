        <name>Date Signup</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === oldValue) {
        return;  
    }

    var userId = g_user.userID;  // ID do usuário atual
    var trainingScheduleId = g_form.getValue('training');  // ID da agenda de treinamento
    var trainingDate = g_form.getValue('schedule');  
    
    // Verifica se a data está no formato correto (dd/MM/yyyy)
    var dateParts = trainingDate.split('/');
    var formattedDate = dateParts[2] + '-' + dateParts[1] + '-' + dateParts[0];  // Formato yyyy-MM-dd

    // Cria o GlideAjax para chamar o Script Include
    var ga = new GlideAjax('x_1593191_cooknow.DateSignup');
    ga.addParam('sysparm_name', 'checkUserRegistration');
    ga.addParam('sysparm_userId', userId);
    ga.addParam('sysparm_trainingScheduleId', trainingScheduleId);
    ga.addParam('sysparm_trainingDate', formattedDate);  // Passa a data formatada

    // Faz a chamada assíncrona e trata a resposta
    ga.getXMLAnswer(function(response) {
        if (response === true) {
            // Se a resposta for 'true', o usuário já está inscrito
            g_form.addErrorMessage("You are already registered for this training on the selected date.");
            g_form.setValue('training_date', oldValue);  // Reverte para o valor anterior
        }
    });
}]]></script>
