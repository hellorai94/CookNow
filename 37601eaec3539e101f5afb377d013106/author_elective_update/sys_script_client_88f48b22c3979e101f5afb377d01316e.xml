        <field>date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Not set same date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
 
   var curso = g_form.getValue('training');
   var data = g_form.getValue('date');
 
   if (curso && data) {
      var ga = new GlideAjax('TrainingScheduler');
      ga.addParam('sys_id', 'checkTrainingExists');
      ga.addParam('training', curso);
      ga.addParam('date', data);
      ga.getXMLAnswer(function(response) {
         var answer = response.responseXML.documentElement.getAttribute("answer");
         if (answer === 'true') {
            g_form.showFieldMsg('training_date', 'Já existe um treinamento agendado para esse curso nesta data.', 'error');
            g_form.setValue('training_date', '');
         } else {
            g_form.hideFieldMsg('training_date');
         }
      });
   }
}]]></script>
