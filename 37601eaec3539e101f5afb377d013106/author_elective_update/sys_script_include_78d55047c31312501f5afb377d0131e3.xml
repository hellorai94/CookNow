        <script><![CDATA[var DuplicateSingUp = Class.create();
DuplicateSingUp.prototype = {
    initialize: function() {},

    uniqueRegistration: function() {
        var coursesNotToBeShown = [];
        var grRegistration = new GlideRecord('x_1593191_cooknow_registration');
        grRegistration.addEncodedQuery('opened_byDYNAMICd921f215f510180a9ad257f2b477fe7^state=3');
        grRegistration.query();

        while (grRegistration.next()) {
            coursesNotToBeShown.push(grRegistration.agenda.sys_id.toString());
        }

        var filteredAgenda = [];
        var grAgenda = new GlideRecord('x_1593191_cooknow_training_schedule');
        grAgenda.query();

        while (grAgenda.next()) {
            if (coursesNotToBeShown.indexOf(grAgenda.sys_id.toString()) == -1) {
                filteredAgenda.push("sys_id=" + grAgenda.sys_id.toString() + "^OR");
            }
        }
		alert(filteredAgenda);
		return "sys_idIN" + filteredAgenda.join(',');
    },
	type: 'DuplicateSingUp'
};]]></script>
