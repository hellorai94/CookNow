        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var trainingId = g_form.getValue('training');  // ID do curso selecionado
    var userId = g_user.userID;  // ID do usuário atual

    var ga = new GlideAjax('getAvailableCourseDates');
    ga.addParam('sysparm_name', 'getAvailableDates');
    ga.addParam('trainingId', trainingId);
    ga.addParam('userId', userId);
    ga.getXMLAnswer(function(response) {
        var availableDates = response.responseXML.documentElement.getAttribute("answer");
        var filter = availableDates;
        g_form.setReferenceQual('date', filter);  // Aplica o filtro ao campo de data
    });
}]]></script>
