        <script><![CDATA[(function executeRule(current, previous /* null when async */) {
   // Verifica se já existe um treinamento do mesmo curso na mesma data
   var gr = new GlideRecord('x_1593191_cooknow_training_schedule'); // Substitua pela tabela correta
   gr.addQuery('training', current.training); // Substitua 'course' pelo campo do curso
   gr.addQuery('date', current.date); // Substitua 'date' pelo campo da data
   gr.query();

   if (gr.next()) {
      gs.addErrorMessage('Já existe um treinamento agendado para este curso nesta data.');
      current.setAbortAction(true); // Cancela a operação
   }
})(current, previous);]]></script>
