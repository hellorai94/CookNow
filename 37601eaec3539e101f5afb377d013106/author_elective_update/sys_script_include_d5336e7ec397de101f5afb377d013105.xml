        <name>RegistrationUtilsAjax</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckUserEnrollment = Class.create();
CheckUserEnrollment.prototype = {
    initialize: function() {},
    
    checkEnrollment: function(userId, trainingId, date) {
        var grEnrollment = new GlideRecord('x_1593191_cooknow_registration');
        grEnrollment.addQuery('user', userId); // Verifica pelo usuário
        grEnrollment.addQuery('training', trainingId); // Verifica pelo curso
        grEnrollment.addQuery('date', date); // Verifica pela data
        grEnrollment.query();
        if (grEnrollment.next()) {
            return true;  // Usuário já está matriculado para essa data
        }
        return false;  // Usuário não está matriculado
    },

    type: 'CheckUserEnrollment'
};]]></script>
