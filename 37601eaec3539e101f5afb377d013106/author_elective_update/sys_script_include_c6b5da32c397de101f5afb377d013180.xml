    <sys_script_include action="DELETE">
        <access>package_private</access>
        <active>true</active>
        <api_name>x_1593191_cooknow.getAvailableCourseDates</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>getAvailableCourseDates</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var getAvailableCourseDates = Class.create();
getAvailableCourseDates.prototype = {
    initialize: function() {
    },

    getAvailableDates: function(trainingId, userId) {
        var enrolledDates = [];

        // Consulta para buscar as datas que o usuário já está matriculado
        var grEnrollment = new GlideRecord("x_1593191_cooknow_training_schedule");
        grEnrollment.addQuery("user", userId);
        grEnrollment.addQuery("training", trainingId);
        grEnrollment.query();
        while (grEnrollment.next()) {
            enrolledDates.push(grEnrollment.date.toString());
        }

        var availableDates = [];
        var grCourses = new GlideRecord("x_1593191_cooknow_training_schedule");
        grCourses.addQuery("training", trainingId); // Filtro pelo curso
        grCourses.query();
        while (grCourses.next()) {
            if (enrolledDates.indexOf(grCourses.date.toString()) == -1) {
                availableDates.push(grCourses.date.toString());
            }
        }

        // Retorna a lista de datas que o usuário ainda não está matriculado
        return "dateIN" + availableDates.join(",");
    },

    type: 'getAvailableCourseDates'
};]]></script>
