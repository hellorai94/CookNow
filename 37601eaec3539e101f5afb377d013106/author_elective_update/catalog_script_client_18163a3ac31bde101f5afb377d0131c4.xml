        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var course = g_form.getValue('training'); // Obtém o curso selecionado
   var trainingDate = newValue;

   // Formatar a data para o formato yyyy-mm-dd
   var formattedDate = formatDate(trainingDate);

   var ga = new GlideAjax('TrainingScheduler');

   ga.addParam('sysparm_name', 'checkTrainingExists');
   ga.addParam('training', course);
   ga.addParam('date', formattedDate);

   ga.getXMLAnswer(function(response) {
      var result = response;
	alert(result);
      if (result === 'true') {
         // Mostrar mensagem de erro sem limpar o campo diretamente
         g_form.showFieldMsg('date', 'Já existe um treinamento agendado para esse curso nesta data.', 'error');
      } else {
         g_form.hideFieldMsg('date');
      }
   });

   // Função para converter data de dd/mm/yyyy para yyyy-mm-dd
   function formatDate(dateStr) {
      var dateParts = dateStr.split('/');
      if (dateParts.length === 3) {
         return '20' + dateParts[2] + '-' + dateParts[1] + '-' + dateParts[0];
      }
      return dateStr; // Retorna a data original caso esteja incorreta
   }
}]]></script>
