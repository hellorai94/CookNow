        <name>Not the same date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var trainingId = g_form.getValue('training'); // ID do curso selecionado
    var userId = g_user.userID; // ID do usuário atual

    var ga = new GlideAjax('GetUserCourseDates');  // Nome do Script Include
    ga.addParam('sysparm_name', 'getAvailableDates');  // Função que será chamada no Script Include
    ga.addParam('sysparm_training_id', trainingId);  // Passa o ID do curso
    ga.addParam('sysparm_user_id', userId);  // Passa o ID do usuário

    ga.getXMLAnswer(function(response) {
        var availableDates = JSON.parse(response.responseText);
        if (availableDates.success) {
            var filter = 'dateIN' + availableDates.dates;  // Filtro para as datas disponíveis
            g_form.setReferenceQual('date', filter);  // Aplica o filtro ao campo 'date'
        } else {
            g_form.setReferenceQual('date', '');  // Caso não haja datas disponíveis
        }
    });
}]]></script>
