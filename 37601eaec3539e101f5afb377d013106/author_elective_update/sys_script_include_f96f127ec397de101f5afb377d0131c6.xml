        <description/>
        <mobile_callable>false</mobile_callable>
        <name>GetUserCourseDates</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var GetUserCourseDates = Class.create();
GetUserCourseDates.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    getAvailableDates: function() {
        var trainingId = this.getParameter('sysparm_training_id');
        var userId = this.getParameter('sysparm_user_id');
        var enrolledDates = [];

        // Consulta para pegar as datas em que o usuário já está matriculado
        var grEnrollment = new GlideRecord("x_1593191_cooknow_training_schedule");
        grEnrollment.addQuery("user", userId);
        grEnrollment.addQuery("training", trainingId);
        grEnrollment.query();
        while (grEnrollment.next()) {
            enrolledDates.push(grEnrollment.date.getDisplayValue()); // Pega as datas de matrícula
        }

        var availableDates = [];
        var grCourses = new GlideRecord("x_1593191_cooknow_training_schedule");
        grCourses.addQuery("training", trainingId); // Consulta por todas as datas do curso
        grCourses.query();
        while (grCourses.next()) {
            if (enrolledDates.indexOf(grCourses.date.getDisplayValue()) == -1) {
                availableDates.push(grCourses.date.getDisplayValue()); // Adiciona a data se o usuário não estiver matriculado
            }
        }

        // Retorna as datas que o usuário ainda não está matriculado
        if (availableDates.length > 0) {
            return JSON.stringify({
                success: true,
                dates: availableDates.join(",")  // Retorna as datas separadas por vírgula
            });
        } else {
            return JSON.stringify({
                success: false,
                message: "Não há datas disponíveis para esse curso."  // Retorna uma mensagem caso não haja datas
            });
        }
    },

    type: 'GetUserCourseDates'
});]]></script>
