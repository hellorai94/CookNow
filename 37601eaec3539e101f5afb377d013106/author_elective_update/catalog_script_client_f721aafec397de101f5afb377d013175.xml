        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return; // Se o formulário estiver carregando ou o campo estiver vazio, não faz nada
    }

    var trainingId = g_form.getValue('training');  // ID do curso selecionado
    var date = g_form.getValue('date');  // Data selecionada
    var userId = g_user.userID;  // ID do usuário atual

    var ga = new GlideAjax('CheckUserEnrollment'); // Nome do Script Include
    ga.addParam('sysparm_name', 'checkEnrollment'); // Nome da função no Script Include
    ga.addParam('userId', userId);  // Passando o ID do usuário
    ga.addParam('trainingId', trainingId);  // Passando o ID do curso
    ga.addParam('date', date);  // Passando a data

    ga.getXMLAnswer(function(response) {
        var result = response.responseXML.documentElement.getAttribute("answer");

        if (result === 'true') {
            g_form.showFieldMsg('date', 'Você já está matriculado para este curso nesta data.', 'error');
        } else {
            g_form.hideFieldMsg('date');  // Esconde a mensagem de erro caso o usuário não esteja matriculado
        }
    });
}]]></script>
