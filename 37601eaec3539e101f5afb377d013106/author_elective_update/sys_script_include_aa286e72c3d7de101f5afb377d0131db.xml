    <sys_script_include action="DELETE">
        <access>package_private</access>
        <active>true</active>
        <api_name>x_1593191_cooknow.CheckUserEnrollment</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>CheckUserEnrollment</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckUserEnrollment = Class.create();
CheckUserEnrollment.prototype = {
    initialize: function() {},

    checkEnrollment: function(userId, trainingId, date) {
        gs.info("Checking enrollment for User: " + userId + ", Training: " + trainingId + ", Date: " + date);
        
        var grEnrollment = new GlideRecord('x_1593191_cooknow_registration');
        grEnrollment.addQuery('user', userId);
        grEnrollment.addQuery('training', trainingId);
        grEnrollment.addQuery('date', date);
        grEnrollment.query();
        
        if (grEnrollment.next()) {
            gs.info("User already enrolled for this date.");
            return true;  // Usuário já está matriculado
        } else {
            gs.info("User not enrolled for this date.");
            return false;  // Usuário não está matriculado
        }
    },

    type: 'CheckUserEnrollment'
};]]></script>
