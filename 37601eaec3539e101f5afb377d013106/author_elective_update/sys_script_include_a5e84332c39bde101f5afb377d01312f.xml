        <script><![CDATA[var dataUtils = Class.create(); 
dataUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, { 
    checkDuplicatesDates: function() { 
        var date = this.getParameter("sysparm_trainingDate"); 
        var training = this.getParameter("sysparm_trainingSysId"); 

        var grTraining = new GlideRecord("x_1593191_cooknow_training_schedule"); 
        grTraining.addQuery("training", training); 
        grTraining.addQuery("date", date); 
        grTraining.query(); 

        if (grTraining.next()) { 
            return 'true'; 
        } else { 
            return 'false'; 
        }
    },

    type: 'dataUtils' 
});]]></script>
