    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description/>
        <field>date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Not supported same date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) return;
 
    var courseId = g_form.getValue('training');
    var trainingDate = g_form.getValue('date');
 
    if (!courseId || !trainingDate) return;
 
    var ga = new GlideAjax('TrainingScheduler');
    ga.addParam('sys_id', 'checkTrainingConflict');
    ga.addParam('training', courseId);
    ga.addParam('date', trainingDate);
    ga.getXMLAnswer(function(response) {
        var conflict = response.responseXML.documentElement.getAttribute("answer");
        if (conflict == 'true') {
            g_form.addErrorMessage('Já existe um treinamento agendado para essa data neste curso.');
        } else {
            g_form.clearMessages();
        }
    });
}]]></script>
